{
  "schemaVersion": 1,
  "id": "watson",
  "name": "Watson",
  "description": "Dr. John H. Watson, Holmes's closest friend and chronicler.",
  "items": [
    {
      "kind": "slot",
      "id": "character-instruction",
      "slot": "system-char"
    },
    {
      "kind": "slot",
      "id": "profile",
      "slot": "file",
      "options": {
        "path": ["README.md", "identity.md", "personality.md"],
        "baseDir": "characters/watson",
        "stripFrontmatter": true,
        "onMissing": "skip"
      }
    },
    { "kind": "slot", "id": "chat-history", "slot": "chat-history" }
  ]
}
