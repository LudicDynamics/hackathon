{
  "schemaVersion": 1,
  "id": "shopkeeper",
  "name": "Mr. Tokiwa",
  "description": "The second-generation owner, polishing a radio nobody will collect.",
  "items": [
    {
      "kind": "slot",
      "id": "character-instruction",
      "slot": "system-char"
    },
    {
      "kind": "slot",
      "id": "profile",
      "slot": "file",
      "options": {
        "path": [
          "README.md",
          "identity.md",
          "personality.md",
          "memory.md"
        ],
        "baseDir": "characters/shopkeeper",
        "stripFrontmatter": true,
        "onMissing": "skip"
      }
    },
    {
      "kind": "slot",
      "id": "chat-history",
      "slot": "chat-history"
    }
  ]
}
