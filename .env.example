# Copy to .env and fill in. .env / .env.local are gitignored — NEVER commit credentials.

# --- TTS: character voice (DashScope, Singapore region) -----------------------
# .env is gitignored (.gitignore:8) — NEVER commit it (docs/tts/00 §3.3 / §9.9).
DASHSCOPE_API_KEY=sk-your-dashscope-intl-key
AIRP_TTS_MODEL=qwen3-tts-flash-2025-11-27
AIRP_TTS_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
AIRP_TTS_TIMEOUT_MS=15000
AIRP_TTS_DEFAULT_VOICE=Cherry

# --- Writer / image agents ----------------------------------------------------
AIRP_WORLD=worlds/unwritten-door-demo
AIRP_WRITER_MODEL=openai/gpt-4.1
# Short interactive beats use a low reasoning budget; increase for slower, deeper turns.
AIRP_WRITER_THINKING=low
AIRP_IMAGE_MODEL=openai/gpt-image-2
OPENAI_BASE_URL=https://api.openai.com/v1
AIRP_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Optional DeepSeek V4.1 Flash credentials.
# DEEPSEEK_API_KEY=
# .local.env is also supported and takes precedence over .env.local / .env.
AIRP_IMAGE_QUALITY=low
AIRP_IMAGE_TIMEOUT_MS=180000
# Inactivity budget; text/tool progress refreshes it. Hard turn limit: 5 minutes.
AIRP_TURN_TIMEOUT_MS=240000

# For a custom writer gateway, configure its provider and model in
# .pi/agent/models.json, using an environment variable for its API key.
# The frontend remains http://localhost:5173 and proxies to server port 3001.

# --- Flow 生图/生视频（本地反代，见 assets/skills/flow-media/SKILL.md）---------
# 反代服务在 ../flow-proxy-api，默认监听 8317。KEY 对应其 config.yaml 的 api-keys。
FLOW_API_BASE=http://127.0.0.1:8317
FLOW_API_KEY=sk-flow-your-proxy-key
FLOW_VIDEO_TIMEOUT_MS=900000
