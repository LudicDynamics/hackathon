{
  "name": "airp-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @airp/server --filter @airp/web dev",
    "dev:server": "pnpm --filter @airp/server dev",
    "dev:web": "pnpm --filter @airp/web dev",
    "build": "pnpm --filter @airp/shared build && pnpm --filter @airp/server build && pnpm --filter @airp/web build",
    "scaffold": "node tools/scaffold.mjs",
    "probe": "node tools/probe-writer.mjs",
    "probe:tools": "node tools/probe-tools.mjs && node tools/probe-tools-engine.mjs",
    "typecheck:extensions": "tsc -p extensions/tsconfig.json",
    "check:docs": "node tools/check-hooks-docs.mjs",
    "pi": "node tools/pi-rp.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
