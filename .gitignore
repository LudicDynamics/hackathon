node_modules/
dist/
.DS_Store
*.log
*.tsbuildinfo
**/.airpworld/*.db*
.airpworld/*.db*
.env
.env.local
.env.*.local
.artifacts/
worlds/
# Ship the six canonical *-playtest templates; ignore experimental revisions.
templates/*-playtest-*/

# --- assets/ : worldlines-assets 素材车间 ---
# AI 生图候选（PNG/JPG）合计约 587MB，作为生产参考太占库，整树不追踪。
# 只追踪我们自己产出的音乐（assets/audio/**，Pixabay 免版税 BGM / 环境声）。
assets/**
!assets/audio/
!assets/audio/**
# 素材生产的手艺包（文本，无大二进制）——工具见 tools/motion-clip.mjs
!assets/skills/
!assets/skills/**
# 车间入口说明（纯文本；AGENTS.md §7.8 引用它作为 assets/ 的入库口径真相源）
!assets/README.md
**/.airpworld/prompt-presets/
**/.airpworld/model-preferences.json
**/.airpworld/model-preferences.json.tmp
# pi-rp session memory is runtime state, never template content truth
**/.pi/*.db*

# TTS audio cache lives at <worldRoot>/.airpworld/tts-cache/ (docs/tts/00 §2.3).
# A per-world runtime product — never committed. NOT `**/.airpworld/`, which
# would blur the prompt-presets rule above and block any future tracked content.
**/.airpworld/tts-cache/

# Agent session transcripts live at <worldRoot>/.airpworld/sessions/ (launch.ts
# `sessionsDirOf`): per-machine conversation history, not part of the artifact.
# Tracked templates WERE picking these up (the world-scoped *.db*/presets rules
# above don't cover a plain directory), so a `git add .` after a dev run would
# commit real dialogue. Same three-dir policy as above — deliberately not
# `**/.airpworld/`, which would block future tracked content.
**/.airpworld/sessions/

# pi-rp agent config (PI_CODING_AGENT_DIR -> .pi/agent). models.json holds real API keys
# and settings.json holds per-machine prefs — this repo is a public hackathon artifact,
# so neither is committed. Copy them from a teammate's checkout to run a real provider.
.pi/agent/models.json
.pi/agent/settings.json
.pi/agent/auth.json
.pi/agent/models-store.json
.pi/agent/sessions/

# Agent-runtime scratch that any harness (omp / pi) drops into a project dir.
# The MCP memory DB is per-machine state, never part of the artifact.
.pi/memory.db*
**/.pi/memory.db*
