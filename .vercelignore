# Upload the same sources as the container, including its build configuration.
*
!Dockerfile.vercel
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!apps
!apps/**
!packages
!packages/**
!vendor
!vendor/pi-rp
!vendor/pi-rp/**
!extensions
!extensions/**
!presets
!presets/**
!skills
!skills/**
!config
!config/**
!templates
!templates/**
!assets
!assets/audio
!assets/audio/**
!assets/models
!assets/models/arcane-d10
!assets/models/arcane-d10/*.glb
!tools
!tools/pi-rp.mjs
!tools/start-vercel.mjs

# These exclusions must follow the allowlist, including inside the submodule.
**/node_modules
**/dist
**/.git
**/.pi
**/.airpworld
**/.env
**/.env.*
**/.local.env
**/*.tsbuildinfo
**/*.log
**/.DS_Store
**/.artifacts
