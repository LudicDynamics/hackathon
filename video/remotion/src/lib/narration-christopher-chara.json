  "duration": 2.076,
  "tempo": 1,
  "fits": true
 },
 {
  "from": 154.2,
  "to": 156.6,
  "text": "Or start with nothing but a promise.",
  "file": "vo/christopher-chara/n-22.wav",
  "duration": 1.937,
  "tempo": 1,
  "fits": true
 },
 {
  "from": 164.6,
  "to": 169.8,
  "text": "Say yes, and the writer agent builds the next place as you walk into it.",
