  "duration": 3.89,
  "tempo": 1,
  "fits": true
 },
 {
  "from": 170.3,
  "to": 174.1,
  "text": "Every character has a place of their own, too.",
  "file": "vo/christopher-chara/n-24.wav",
  "duration": 2.536,
  "tempo": 1,
  "fits": true
 },
 {
  "from": 178.2,
  "to": 181.8,
  "text": "And it never runs out.",
  "file": "vo/christopher-chara/n-25.wav",
  "duration": 1.258,
  "tempo": 1,
  "fits": true
 },
 {
  "from": 182.2,
  "to": 185.5,
  "text": "With GPT Live, you can call a character and talk in real time.",
