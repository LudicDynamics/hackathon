{
  "name": "@airp/shared",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./frontmatter": {
      "types": "./dist/schemas/frontmatter.d.ts",
      "import": "./dist/schemas/frontmatter.js"
    },
    "./forms": {
      "types": "./dist/schemas/forms.d.ts",
      "import": "./dist/schemas/forms.js"
    },
    "./world-settings": {
      "types": "./dist/schemas/world-settings.d.ts",
      "import": "./dist/schemas/world-settings.js"
    },
    "./viewpoint": {
      "types": "./dist/render/viewpoint.d.ts",
      "import": "./dist/render/viewpoint.js"
    },
    "./performances": {
      "types": "./dist/components/performances.d.ts",
      "import": "./dist/components/performances.js"
    },
    "./layout": {
      "types": "./dist/layout/flow-columns.d.ts",
      "import": "./dist/layout/flow-columns.js"
    },
    "./tts-text": {
      "types": "./dist/rules/tts-text.d.ts",
      "import": "./dist/rules/tts-text.js"
    },
    "./appearance-registry": {
      "types": "./dist/components/appearance-registry.d.ts",
      "import": "./dist/components/appearance-registry.js"
    },
    "./appearance-schema": {
      "types": "./dist/schemas/appearance.d.ts",
      "import": "./dist/schemas/appearance.js"
    },
    "./characters": {
      "types": "./dist/rules/characters.d.ts",
      "import": "./dist/rules/characters.js"
    },
    "./dice": {
      "types": "./dist/rules/dice.d.ts",
      "import": "./dist/rules/dice.js"
    },
    "./protocol": {
      "types": "./dist/protocol/ws.d.ts",
      "import": "./dist/protocol/ws.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w"
  },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
